prefix=@@M_UNIX_INSTALL_PREFIX@@
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include/meegotouch

Name: meegotouchsettings
Description: MeeGo Touch UI Framework settings module
Version: @@M_VERSION@@
Requires: Qt5Gui Qt5Widgets Qt5X11Extras
Cflags: -I${includedir} -DQ_WS_X11
Libs: -L${libdir} -lmeegotouchcore -lmeegotouchsettings
