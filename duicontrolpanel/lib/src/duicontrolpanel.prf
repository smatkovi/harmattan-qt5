# dcpconfig.pri is installed next to the features directory (found
# there also when the features come from QMAKEFEATURES)
include($$PWD/../dcpconfig.pri)

# extending include path
INCLUDEPATH += $$DCP_INSTALL_HEADERS
DEPENDPATH += $$DCP_INSTALL_HEADERS

#LIBS += -L$${DCP_INSTALL_LIB} -lduicontrolpanel
LIBS += -lduicontrolpanel

